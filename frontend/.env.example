# Variables de entorno del frontend (joja.click).
# Copia este archivo como .env.local para desarrollo local.
# Los valores se inyectan en tiempo de compilación mediante Vite (import.meta.env).
# Nunca incluyas credenciales de AWS (claves de acceso, secretos, tokens) aquí.

# Origen de la API que provee los contratos de archivos, cargas y logs.
# Reemplazar por la URL real de la API cuando exista backend autorizado.
VITE_API_BASE_URL=http://localhost:5173/api

# Prefijo lógico del bucket de activos (solo referencia visual, no credencial).
VITE_ASSETS_BUCKET_PREFIX=object-storage-prod-activos

# Dominio público del sitio (sin protocolo).
VITE_SITE_DOMAIN=joja.click
